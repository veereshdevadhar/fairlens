{
  "version": 2,
  "builds": {
    "src": "package.json",
    "use": "@vercel/static-build",
    "config": {
      "distDir": "build"
    }
  },
  "routes": [
    {
      "src": "build/index.html",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "@fairlens-backend-url"
  },
  "build": {
    "env": {
      "REACT_APP_API_URL": "@fairlens-backend-url"
    }
  }
}
